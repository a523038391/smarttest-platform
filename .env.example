DATABASE_URL=
# Keep true outside isolated automated tests.
AUTH_REQUIRED=true
# Set true when the public site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
# Git control is disabled by default and requires an absolute managed repository.
VERSION_CONTROL_ENABLED=false
VERSION_CONTROL_ROOT=
# Windows local supervisor IPC. Keep disabled when starting services manually.
SERVICE_CONTROL_ENABLED=false
# Must be an absolute path when service control is enabled.
SERVICE_CONTROL_ROOT=
# Requires SERVICE_CONTROL_ENABLED=true.
VERSION_CONTROL_AUTO_RESTART=false
CELERY_BROKER_URL=redis://localhost:6379/0
RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
AUTO_DISPATCH=false
ARTIFACT_ROOT=.artifacts
SOURCE_ROOT=.sources
# With AUTO_DISPATCH=true, execute DISPATCHING runs in this API process.
LOCAL_RUNNER_ENABLED=false
RUNNER_IMAGE=smarttest-runner:local
# Keep none unless tests explicitly need outbound/host network access.
RUNNER_NETWORK=none
RUNNER_WORK_ROOT=.runner-work
RUNNER_MAX_WORKERS=2
RUNNER_POLL_INTERVAL_SECONDS=0.5
ATTEMPT_REAPER_INTERVAL_SECONDS=30
# Base64-encoded 32-byte KEK. Public environment operations work when unset.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_ID=
# Existing host tmpfs mount used only by the node-local Runner Manager.
SECRET_STAGING_ROOT=/run/smarttest-secrets
SECRET_CAPABILITY_TTL_SECONDS=60
RUNNER_UID=65532
RUNNER_GID=65532
AUTH_REQUIRED=true
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400